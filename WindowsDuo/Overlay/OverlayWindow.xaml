<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsDuo.Overlay.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <!--
        全屏叠加层。没有标题栏、没有边框、铺满整个主显示器，并且全部由代码后置
        配置为"点击穿透 + 不出现在捕获里"。这里刻意不写任何事件属性：
        XAML 事件会在 InitializeComponent() 期间就触发，那时同级 x:Name 字段
        还没赋值，是之前踩过的 NullReferenceException 根因。
    -->

    <Grid Background="Black">
        <canvas:CanvasControl x:Name="OverlayCanvas"
                              ClearColor="Black" />

        <Border x:Name="StatusPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="28,20"
                CornerRadius="10"
                Background="#E6101418"
                BorderBrush="#604470A0"
                BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Spacing="6">
                <TextBlock x:Name="StatusTitle"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#FFF0F4FA"
                           Text="叠加层" />
                <TextBlock x:Name="StatusDetail"
                           FontSize="14"
                           MaxWidth="760"
                           TextWrapping="Wrap"
                           Foreground="#FFC6D2E2"
                           Text="" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
